/* Resource script for CrossUDP palette icons.
   Compile with: brcc32 CrossUDPSockets.rc
   This will produce CrossUDPSockets.res which is referenced by the package.
*/

// Class-name resources (most Delphi package setups resolve these)
TCROSSUDPCLIENT BITMAP "PaletteIcons\\CrossUDPClient.bmp"
TCROSSUDPSERVER BITMAP "PaletteIcons\\CrossUDPServer.bmp"

// Alias resources (some setups resolve without leading T)
CROSSUDPCLIENT BITMAP "PaletteIcons\\CrossUDPClient.bmp"
CROSSUDPSERVER BITMAP "PaletteIcons\\CrossUDPServer.bmp"
